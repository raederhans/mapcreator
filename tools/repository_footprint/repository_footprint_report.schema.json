{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenario-forge.local/repository-footprint/report.v1.schema.json",
  "title": "Scenario Forge repository footprint report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "gitObjectDatabase",
    "rankings",
    "comparison",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "commitDate",
        "trackedFileCount",
        "checkoutTreeBytes",
        "checkoutTreeMeasurement"
      ],
      "properties": {
        "commit": { "$ref": "#/definitions/objectId" },
        "commitDate": { "type": "string", "format": "date-time" },
        "trackedFileCount": { "type": "integer", "minimum": 0 },
        "checkoutTreeBytes": { "type": "integer", "minimum": 0 },
        "checkoutTreeMeasurement": {
          "type": "string",
          "const": "sum-of-git-tree-path-blob-bytes"
        }
      }
    },
    "gitObjectDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "looseObjectCount",
        "looseObjectBytes",
        "packedObjectCount",
        "packCount",
        "packBytes",
        "prunePackableObjectCount",
        "garbageObjectCount",
        "garbageBytes",
        "totalObjectStoreBytes",
        "scope",
        "measurement"
      ],
      "properties": {
        "looseObjectCount": { "type": "integer", "minimum": 0 },
        "looseObjectBytes": { "type": "integer", "minimum": 0 },
        "packedObjectCount": { "type": "integer", "minimum": 0 },
        "packCount": { "type": "integer", "minimum": 0 },
        "packBytes": { "type": "integer", "minimum": 0 },
        "prunePackableObjectCount": { "type": "integer", "minimum": 0 },
        "garbageObjectCount": { "type": "integer", "minimum": 0 },
        "garbageBytes": { "type": "integer", "minimum": 0 },
        "totalObjectStoreBytes": { "type": "integer", "minimum": 0 },
        "scope": { "type": "string", "const": "shared-git-object-database" },
        "measurement": { "type": "string", "const": "git-count-objects-kib-converted-to-bytes" }
      }
    },
    "rankings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topN", "pathGroupDepth", "topBlobsByBytes", "topPathGroupsByTotalBytes"],
      "properties": {
        "topN": { "type": "integer", "minimum": 1 },
        "pathGroupDepth": { "type": "integer", "minimum": 1 },
        "topBlobsByBytes": {
          "type": "array",
          "items": { "$ref": "#/definitions/blobRanking" }
        },
        "topPathGroupsByTotalBytes": {
          "type": "array",
          "items": { "$ref": "#/definitions/pathRanking" }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCommit", "largeBlobThresholdBytes", "changedLargeBlobs", "changedLargeBlobCounts"],
      "properties": {
        "baseCommit": { "$ref": "#/definitions/objectId" },
        "largeBlobThresholdBytes": { "type": "integer", "minimum": 1 },
        "changedLargeBlobs": {
          "type": "array",
          "items": { "$ref": "#/definitions/changedLargeBlob" }
        },
        "changedLargeBlobCounts": { "$ref": "#/definitions/classCounts" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "outcome",
        "evaluatedAt",
        "baselineCommit",
        "largeAssetCounts",
        "largeAssetInventory",
        "findings"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["report-only", "gate"] },
        "outcome": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "evaluatedAt": { "type": "string", "format": "date" },
        "baselineCommit": { "$ref": "#/definitions/objectId" },
        "largeAssetCounts": { "$ref": "#/definitions/classCounts" },
        "largeAssetInventory": {
          "type": "array",
          "items": { "$ref": "#/definitions/classifiedBlob" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/finding" }
        }
      }
    }
  },
  "definitions": {
    "objectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "managementClass": {
      "type": "string",
      "enum": [
        "existing-grandfathered",
        "managed-manifest",
        "waived-unmanaged",
        "new-unmanaged-large-blob"
      ]
    },
    "classCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingGrandfathered",
        "managedManifest",
        "waivedUnmanaged",
        "newUnmanagedLargeBlob"
      ],
      "properties": {
        "existingGrandfathered": { "type": "integer", "minimum": 0 },
        "managedManifest": { "type": "integer", "minimum": 0 },
        "waivedUnmanaged": { "type": "integer", "minimum": 0 },
        "newUnmanagedLargeBlob": { "type": "integer", "minimum": 0 }
      }
    },
    "classifiedBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "oid", "bytes", "managementClass", "waiverId"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "oid": { "$ref": "#/definitions/objectId" },
        "bytes": { "type": "integer", "minimum": 0 },
        "managementClass": { "$ref": "#/definitions/managementClass" },
        "waiverId": { "type": ["string", "null"] }
      }
    },
    "changedLargeBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeType",
        "path",
        "oid",
        "bytes",
        "previousOid",
        "previousBytes",
        "managementClass",
        "waiverId"
      ],
      "properties": {
        "changeType": { "type": "string", "enum": ["added", "replaced"] },
        "path": { "type": "string", "minLength": 1 },
        "oid": { "$ref": "#/definitions/objectId" },
        "bytes": { "type": "integer", "minimum": 0 },
        "previousOid": {
          "anyOf": [
            { "$ref": "#/definitions/objectId" },
            { "type": "null" }
          ]
        },
        "previousBytes": { "type": ["integer", "null"], "minimum": 0 },
        "managementClass": { "$ref": "#/definitions/managementClass" },
        "waiverId": { "type": ["string", "null"] }
      }
    },
    "blobRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oid", "bytes", "paths", "pathCount"],
      "properties": {
        "oid": { "$ref": "#/definitions/objectId" },
        "bytes": { "type": "integer", "minimum": 0 },
        "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "pathCount": { "type": "integer", "minimum": 1 }
      }
    },
    "pathRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "totalBytes", "trackedFileCount"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "trackedFileCount": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "oid", "bytes", "message"],
      "properties": {
        "code": { "type": "string", "const": "new-unmanaged-large-blob" },
        "severity": { "type": "string", "const": "warning" },
        "path": { "type": "string", "minLength": 1 },
        "oid": { "$ref": "#/definitions/objectId" },
        "bytes": { "type": "integer", "minimum": 0 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
