{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenario-forge.local/repository-footprint/manifest.v1.schema.json",
  "title": "Scenario Forge repository footprint baseline and waiver manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "baseline",
    "managedAssets",
    "waivers"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "largeBlobThresholdBytes",
        "topN",
        "pathGroupDepth"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["report-only", "gate"]
        },
        "largeBlobThresholdBytes": {
          "type": "integer",
          "minimum": 1
        },
        "topN": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "pathGroupDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "trackedFileCount", "checkoutTreeBytes"],
      "properties": {
        "commit": {
          "$ref": "#/definitions/objectId"
        },
        "trackedFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "checkoutTreeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "managedAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "manifestPath", "managementKind", "evidencePointer"],
        "properties": {
          "path": {
            "$ref": "#/definitions/repositoryPath"
          },
          "manifestPath": {
            "$ref": "#/definitions/repositoryPath"
          },
          "managementKind": {
            "type": "string",
            "enum": ["checksum-manifest", "source-manifest"]
          },
          "evidencePointer": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "blobOid", "maxBytes", "expiresOn", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/definitions/repositoryPath"
          },
          "blobOid": {
            "$ref": "#/definitions/objectId"
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1
          },
          "expiresOn": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "objectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+[^/]$"
    }
  }
}
