{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/p4-repository-analysis-digest-receipt-v1.json",
  "title": "Scenario Forge P4 Repository Analysis Digest Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "bundleDigest",
    "factsDigest",
    "source",
    "inputPaths",
    "inputClosure",
    "authorityDigests",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "scenario-forge-p4-repository-analysis-digest-receipt" },
    "bundleDigest": { "$ref": "p4_repository_analysis_bundle.schema.json#/$defs/sha256" },
    "factsDigest": { "$ref": "p4_repository_analysis_bundle.schema.json#/$defs/sha256" },
    "source": { "$ref": "p4_repository_analysis_bundle.schema.json#/$defs/sourceIdentity" },
    "inputPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "p4_repository_analysis_bundle.schema.json#/$defs/repositoryPath" }
    },
    "inputClosure": { "$ref": "p4_repository_analysis_bundle.schema.json#/properties/inputClosure" },
    "authorityDigests": { "$ref": "p4_repository_analysis_bundle.schema.json#/properties/authorityDigests" },
    "receiptDigest": { "$ref": "p4_repository_analysis_bundle.schema.json#/$defs/sha256" }
  }
}
