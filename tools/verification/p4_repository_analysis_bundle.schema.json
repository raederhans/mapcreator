{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/p4-repository-analysis-bundle-v1.json",
  "title": "Scenario Forge P4 Repository Analysis Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "producer",
    "source",
    "inputs",
    "inputClosure",
    "authorityDigests",
    "facts",
    "factsDigest",
    "bundleDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "scenario-forge-p4-repository-analysis-bundle" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "p4-repository-analysis-producer" },
        "version": { "const": 1 }
      }
    },
    "source": { "$ref": "#/$defs/sourceIdentity" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inputBlob" }
    },
    "inputClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "pathOrder", "count", "totalBytes", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "pathOrder": { "const": "utf8-byte-lexicographic-v1" },
        "count": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorityDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner", "policy", "config"],
      "properties": {
        "scanner": { "$ref": "#/$defs/authorityDigest" },
        "policy": { "$ref": "#/$defs/authorityDigest" },
        "config": { "$ref": "#/$defs/authorityDigest" }
      }
    },
    "facts": { "type": "object" },
    "factsDigest": { "$ref": "#/$defs/sha256" },
    "bundleDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "treeSha"],
      "properties": {
        "sha": { "$ref": "#/$defs/sha1" },
        "treeSha": { "$ref": "#/$defs/sha1" }
      }
    },
    "inputBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "bytes", "gitBlobOid", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "mode": { "enum": ["100644", "100755"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "gitBlobOid": { "$ref": "#/$defs/sha1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorityDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "paths", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
