{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/dependency-checkout-profile-report.v1.json",
  "title": "Scenario Forge dependency and checkout profile report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "schemaRef",
    "sourceBinding",
    "dependencyProfiles",
    "profileCommands",
    "p4CheckerBoundaries",
    "checkoutProfiles",
    "closeoutNoCheckoutConditions",
    "laneRecommendation",
    "integrationGaps"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "dependency-checkout-profile-report" },
    "schemaRef": { "const": "tools/verification/dependency_checkout_profile.schema.json" },
    "sourceBinding": {
      "type": "object",
      "required": ["kind", "schemaVersion", "identity", "mode"],
      "properties": {
        "mode": { "const": "read-only" }
      }
    },
    "dependencyProfiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "selection", "nodeInstall", "pythonInstall", "browserInstall"],
        "properties": {
          "id": {
            "enum": ["node-only", "python-stdlib", "python-core", "python-geo", "browser"]
          }
        }
      }
    },
    "profileCommands": {
      "type": "object",
      "required": ["node-only", "python-stdlib", "python-core", "python-geo", "browser"],
      "additionalProperties": false,
      "properties": {
        "node-only": { "$ref": "#/$defs/commandRefs" },
        "python-stdlib": { "$ref": "#/$defs/commandRefs" },
        "python-core": { "$ref": "#/$defs/commandRefs" },
        "python-geo": { "$ref": "#/$defs/commandRefs" },
        "browser": { "$ref": "#/$defs/commandRefs" }
      }
    },
    "p4CheckerBoundaries": {
      "type": "object",
      "required": [
        "commandRefs",
        "pythonRoots",
        "verdict",
        "thirdPartyImports",
        "unresolvedDynamicImports",
        "parseErrors"
      ],
      "properties": {
        "verdict": { "enum": ["stdlib-only", "external-or-unresolved"] }
      }
    },
    "checkoutProfiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "closeoutNoCheckoutConditions": { "type": "array", "minItems": 6 },
    "laneRecommendation": {
      "type": "object",
      "required": ["status", "basis", "recommendedLaneCount", "lanes"],
      "properties": {
        "basis": { "const": "commandWallTimeMs" },
        "recommendedLaneCount": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "integrationGaps": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "commandRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
