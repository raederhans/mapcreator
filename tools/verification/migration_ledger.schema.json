{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenario-forge.local/verification/migration_ledger.schema.json",
  "title": "Scenario Forge Transitional Code Retirement Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "migrations"],
  "properties": {
    "$schema": { "type": "string", "const": "./migration_ledger.schema.json" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "transitional-code-retirement-ledger" },
    "migrations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "legacyOwner",
          "canonicalOwner",
          "requiredGreenRuns",
          "currentGreenRuns",
          "currentIdentity",
          "retirementEligibility",
          "retirementAction",
          "evidence",
          "authorization",
          "blockers"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "legacyOwner": { "type": "string", "minLength": 1 },
          "canonicalOwner": { "type": "string", "minLength": 1 },
          "requiredGreenRuns": { "type": "integer", "minimum": 1 },
          "currentGreenRuns": { "type": "integer", "minimum": 0 },
          "currentIdentity": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "null"], "minLength": 1 }
          },
          "retirementEligibility": {
            "type": "string",
            "enum": ["eligible", "ineligible"]
          },
          "retirementAction": {
            "type": "string",
            "enum": ["retain-legacy", "retain-tracked-dist", "remove-in-separate-authorized-change"]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "receiptKind", "receiptPath", "receiptDigest", "latestRunId", "observedAt", "expiresAt"],
            "properties": {
              "status": { "type": "string", "enum": ["recorded", "recorded-unbound", "missing", "expired"] },
              "receiptKind": { "type": "string", "minLength": 1 },
              "receiptPath": { "type": "string", "minLength": 1 },
              "receiptDigest": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "latestRunId": { "type": "string", "minLength": 1 },
              "observedAt": { "type": "string", "format": "date-time" },
              "expiresAt": { "type": "string", "format": "date-time" }
            }
          },
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "removalAuthorized", "authorizationRef"],
            "properties": {
              "status": { "type": "string", "enum": ["withheld", "authorized"] },
              "removalAuthorized": { "type": "boolean" },
              "authorizationRef": { "type": ["string", "null"], "minLength": 1 }
            }
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
