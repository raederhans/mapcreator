{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenario-forge.local/sf-ats/verification_ledger_entry.schema.json",
  "title": "SF-ATS Verification Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ts",
    "gitSha",
    "planId",
    "commandRef",
    "lane",
    "exitCode",
    "durationMs",
    "artifactPaths",
    "failureClass",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "gitSha": {
      "type": "string",
      "minLength": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "commandRef": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": ["child-safe", "main-thread", "ci-only", "blocked", "manual"]
    },
    "exitCode": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "durationMs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "artifactPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failureClass": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
