{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenario-forge.local/sf-ats/change_dossier.schema.json",
  "title": "SF-ATS Change Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "gitSha",
    "baseSha",
    "discoveryMode",
    "changedFiles",
    "selector",
    "domainSummaries",
    "routeGaps",
    "riskLevel",
    "riskReasons",
    "suggestedNextActions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "gitSha": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "minLength": 1
    },
    "discoveryMode": {
      "type": "string",
      "minLength": 1
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "selector": {
      "type": "object",
      "additionalProperties": true
    },
    "domainSummaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domainId", "changedFiles", "recommendedChecks"],
        "properties": {
          "domainId": {
            "type": "string",
            "minLength": 1
          },
          "changedFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendedChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "riskSignals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "routeGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "reason"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "riskReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggestedNextActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
