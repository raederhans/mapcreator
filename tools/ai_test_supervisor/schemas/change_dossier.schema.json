{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenario-forge.local/sf-ats/change_dossier.schema.json",
  "title": "SF-ATS Change Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "gitSha",
    "baseSha",
    "discoveryMode",
    "changedFiles",
    "selector",
    "domainSummaries",
    "routeGaps",
    "riskLevel",
    "riskReasons",
    "laneSummary",
    "requiredArtifacts",
    "suggestedNextActions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "gitSha": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "minLength": 1
    },
    "discoveryMode": {
      "type": "string",
      "minLength": 1
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "selector": {
      "type": "object",
      "additionalProperties": true
    },
    "domainSummaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domainId", "changedFiles", "recommendedChecks"],
        "properties": {
          "domainId": {
            "type": "string",
            "minLength": 1
          },
          "changedFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendedChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "riskSignals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ownerHints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferredChildSafeChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferredMainThreadChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceArtifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "routeGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "severity", "reason", "suggestedRoute"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "suggestedRoute": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "unknown"]
    },
    "riskReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "laneSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "childSafeCommands",
        "mainThreadCommands",
        "ciOnlyCommands",
        "blockedCommands",
        "counts",
        "resourceLocks",
        "executionOwners"
      ],
      "properties": {
        "childSafeCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["commandRef", "lane"]
          }
        },
        "mainThreadCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["commandRef", "lane"]
          }
        },
        "ciOnlyCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["commandRef", "lane"]
          }
        },
        "blockedCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["childSafe", "mainThread", "ciOnly", "blocked", "total"],
          "properties": {
            "childSafe": { "type": "integer", "minimum": 0 },
            "mainThread": { "type": "integer", "minimum": 0 },
            "ciOnly": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "resourceLocks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executionOwners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggestedNextActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
