{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenario-forge.local/sf-ats/supervisor_plan.schema.json",
  "title": "SF-ATS Supervisor Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "planId",
    "riskLevel",
    "changedFiles",
    "domains",
    "childSafeCommands",
    "mainThreadCommands",
    "ciOnlyCommands",
    "blockedCommands",
    "routeGaps",
    "commandsToRun",
    "requiredArtifacts",
    "executionPolicy",
    "stopConditions",
    "executionResults",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "unknown"]
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "childSafeCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mainThreadCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ciOnlyCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockedCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandRef", "reason"],
        "properties": {
          "commandRef": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commandsToRun": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routeGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "severity", "reason", "suggestedRoute"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "suggestedRoute": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executionResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["commandRef", "exitCode"],
        "properties": {
          "commandRef": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
