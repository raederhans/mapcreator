{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://thematic/layer_index/v1",
  "type": "object",
  "required": ["schema_version", "generated_at", "layers"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "\\S"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "theme",
          "title",
          "geometry_kind",
          "manifest_path",
          "status",
          "source_policy",
          "default_visible",
          "default_style"
        ],
        "properties": {
          "layer_id": {
            "type": "string",
            "pattern": "^[a-z0-9_:-]+$"
          },
          "theme": {
            "enum": [
              "political",
              "economic",
              "social",
              "population",
              "conflict",
              "security",
              "energy",
              "food",
              "water",
              "migration",
              "ideology",
              "heritage"
            ]
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string"
          },
          "geometry_kind": {
            "enum": ["admin0", "admin1", "admin2", "grid_720x360", "point_event", "network_line"]
          },
          "manifest_path": {
            "type": "string",
            "pattern": "^data/thematic_layers/.+/manifest\\.json$"
          },
          "status": {
            "enum": ["fixture", "demo", "experimental", "ready"]
          },
          "source_policy": {
            "enum": ["fixture_only", "manual_seed", "real_source_cache_only", "external_download_supported"]
          },
          "coverage_scope": {
            "type": "string"
          },
          "default_visible": {
            "type": "boolean"
          },
          "default_style": {
            "type": "object",
            "required": ["renderer", "palette", "opacity"],
            "properties": {
              "renderer": {
                "enum": ["choropleth", "grid_heatmap", "points", "lines"]
              },
              "palette": {
                "type": "string",
                "pattern": "\\S"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "neutral_value": {
                "type": ["number", "null"]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "source_policy_legend": {
      "type": "object"
    },
    "status_legend": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
